# Copy to .env.local and fill in real values. .env.local is gitignored.

# Supabase transaction-pooler DSN. Port 6543 = transaction mode (post-Feb-2025).
# Use the alphanumeric-only DB password to avoid URL-encoding pain.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres

# AWS SSO profile name from `aws configure sso`.
AWS_PROFILE=coffer-dev
