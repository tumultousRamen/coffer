# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Two consumers read this file:
#   * Tests (`make integration`, smoketest) — DATABASE_URL, AWS_PROFILE.
#   * `cmd/vault` binary (`make run`) — COFFER_* vars per ADR 0010 §2.
# Same Postgres / same AWS — just two env-var naming conventions until
# one consolidates.

# --- Tests (smoketest, make integration) ---

# Supabase transaction-pooler DSN. Port 6543 = transaction mode (post-Feb-2025).
# Use the alphanumeric-only DB password to avoid URL-encoding pain.
# Same project the smoke test uses; PRD 0004 migrations add `tenants` and
# `credentials` tables alongside the pre-existing `credentials_smoketest`.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:6543/postgres

# AWS SSO profile name from `aws configure sso`. Refresh with
# `aws sso login --profile $AWS_PROFILE` when integration tests fail with
# `InvalidGrantException` from the SSO OIDC endpoint.
AWS_PROFILE=coffer-dev

# --- cmd/vault binary (make run) ---

# Postgres DSN for the vault binary. Same value as DATABASE_URL — the
# vault reads its own COFFER_* prefixed copy per ADR 0010 §2 (all
# runtime config is COFFER_*-prefixed env vars).
COFFER_PG_URL=$DATABASE_URL

# ed25519 PUBLIC key used by the vault to VERIFY capability tokens
# minted by the control plane (PRD 0002 grant tokens; ADR 0002). For
# trial-mode local dev, generate a fresh keypair and paste the PUBLIC
# half here; stash the PRIVATE half wherever your demo script mints
# tokens. One-shot keygen:
#
#   cat > /tmp/keygen.go <<'KEY'
#   package main
#   import (
#       "crypto/ed25519"; "crypto/rand"; "crypto/x509"
#       "encoding/pem"; "fmt"
#   )
#   func main() {
#       pub, priv, _ := ed25519.GenerateKey(rand.Reader)
#       p, _ := x509.MarshalPKIXPublicKey(pub)
#       q, _ := x509.MarshalPKCS8PrivateKey(priv)
#       fmt.Print(string(pem.EncodeToMemory(&pem.Block{Type:"PUBLIC KEY", Bytes:p})))
#       fmt.Print(string(pem.EncodeToMemory(&pem.Block{Type:"PRIVATE KEY", Bytes:q})))
#   }
#   KEY
#   go run /tmp/keygen.go
#
# Then put the PUBLIC block here using $'...' so the \n stay literal:
COFFER_GRANT_PUBKEY_PEM=$'-----BEGIN PUBLIC KEY-----\n<base64-line>\n-----END PUBLIC KEY-----\n'

# --- Optional COFFER_* overrides (defaults shown; uncomment to change) ---

# COFFER_AWS_REGION=us-west-1
# COFFER_AWS_KMS_KEY_ID=alias/coffer-dev-master
# COFFER_GRPC_LISTEN=:8443
# COFFER_HTTP_LISTEN=:8080
# COFFER_DEK_CACHE_TTL_SECONDS=300
# COFFER_DEK_CACHE_MAX_ENTRIES=100000
